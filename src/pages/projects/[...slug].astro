---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

function formatDate(date: Date): string {
  return date.getFullYear().toString();
}

const dateRange = project.data.endDate
  ? `${formatDate(project.data.startDate)}–${formatDate(project.data.endDate)}`
  : `${formatDate(project.data.startDate)}–present`;
---

<Base title={project.data.title} description={project.data.description}>
  <article>
    <header class="project-header">
      <h1 class="project-title">{project.data.title}</h1>
      <div class="project-meta">
        <span class="meta-role">{project.data.role}</span>
        <span class="meta-sep">&middot;</span>
        <span class="meta-dates">{dateRange}</span>
        {project.data.url && (
          <>
            <span class="meta-sep">&middot;</span>
            <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="meta-link">Visit</a>
          </>
        )}
        {project.data.repo && (
          <>
            <span class="meta-sep">&middot;</span>
            <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="meta-link">Source</a>
          </>
        )}
      </div>
      {project.data.tags.length > 0 && (
        <div class="project-tags">
          {project.data.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .project-header {
    margin-bottom: 2rem;
  }

  .project-title {
    font-size: 30px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .project-meta {
    font-size: 14px;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-dates {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .meta-link {
    font-size: 14px;
  }

  .meta-sep {
    color: var(--color-border);
  }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
  }
</style>
