---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const allWriting = await getCollection("writing", ({ data }) => !data.draft);

const sorted = allWriting.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Match complete terms inside legacy tags that joined several topics with hyphens.
const topics = [
  { id: "ai", label: "AI", terms: ["ai", "aeo", "airops", "chatgpt", "claude", "prompting", "context-engineering"] },
  { id: "content", label: "Content marketing", terms: ["content", "seo", "writing", "storytelling", "attribution", "branding"] },
  { id: "productivity", label: "Productivity", terms: ["productivity", "focus", "pomodoro", "timeboxing", "habits", "planning", "breaks", "distraction", "work-life-balance"] },
  { id: "books", label: "Books & reading", terms: ["books", "reading", "book-review"] },
  { id: "teamwork", label: "Agile & teamwork", terms: ["agile", "scrum", "sprint", "retrospectives", "teams", "team-health", "meetings", "management", "collaboration"] },
  { id: "technology", label: "Technology & design", terms: ["design", "tools", "mobile", "kaios", "gaming", "digital-inclusion", "conversational-ui"] },
  { id: "saent", label: "Lifeline & Saent", terms: ["lifeline", "saent", "button"] },
  { id: "travel", label: "Travel & Inside Africa", terms: ["travel", "africa"] },
];
function topicsFor(tags: string[]): string[] {
  return topics.filter(topic => topic.terms.some(term =>
    tags.some(tag => (`-${tag}-`).includes(`-${term}-`))
  )).map(topic => topic.id);
}
const sources = [...new Set(sorted.map(post => post.data.sourceName).filter(Boolean))].sort();

const grouped = sorted.reduce<Map<number, typeof sorted>>((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc.has(year)) acc.set(year, []);
  acc.get(year)!.push(post);
  return acc;
}, new Map());

const years = [...grouped.keys()].sort((a, b) => b - a);

function formatDate(date: Date): string {
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${m}.${d}`;
}
---

<Base title="Writing" description="Articles on productivity, AI, startups, and building software.">
  <h1 class="page-title">Writing</h1>

  <form class="archive-filters" role="search" aria-label="Filter writing" hidden>
    <label class="search-field">
      Search writing
      <input type="search" id="writing-search" placeholder="Title, topic, or publication" autocomplete="off" />
    </label>
    <label>
      Topic
      <select id="writing-topic">
        <option value="">All topics</option>
        {topics.map(topic => <option value={topic.id}>{topic.label}</option>)}
      </select>
    </label>
    <label>
      Publication
      <select id="writing-source">
        <option value="">All publications</option>
        {sources.map(source => <option value={source}>{source}</option>)}
      </select>
    </label>
    <div class="filter-status">
      <p id="result-count" role="status" aria-live="polite">{sorted.length} articles</p>
      <button id="clear-filters" type="button" hidden>Clear filters</button>
    </div>
  </form>
  <p id="no-results" hidden>No articles match these filters. Try another search or clear the filters.</p>

  {years.map(year => (
    <div class="writing-group" data-year={year}>
      <h2 class="year-heading">{year}</h2>
      <div class="writing-entries">
        {grouped.get(year)!.map(post => {
          const isExternal = !!post.data.originalUrl;
          const href = isExternal ? post.data.originalUrl! : `/writing/${post.id}`;
          return (
            <a
              href={href}
              class="writing-entry"
              data-topics={topicsFor(post.data.tags).join(",")}
              data-source={post.data.sourceName ?? ""}
              data-search={[post.data.title, ...post.data.tags, post.data.sourceName ?? ""].join(" ").replaceAll("-", " ").toLowerCase()}
              {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="entry-title">
                {post.data.title}
                {isExternal && <span class="external-indicator" aria-label="External link">&#8599;</span>}
              </span>
              <time class="entry-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </a>
          );
        })}
      </div>
    </div>
  ))}
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>(".archive-filters")!;
  const search = document.querySelector<HTMLInputElement>("#writing-search")!;
  const topic = document.querySelector<HTMLSelectElement>("#writing-topic")!;
  const source = document.querySelector<HTMLSelectElement>("#writing-source")!;
  const clear = document.querySelector<HTMLButtonElement>("#clear-filters")!;
  const count = document.querySelector<HTMLParagraphElement>("#result-count")!;
  const empty = document.querySelector<HTMLParagraphElement>("#no-results")!;
  const entries = [...document.querySelectorAll<HTMLAnchorElement>(".writing-entry")];
  const groups = document.querySelectorAll<HTMLDivElement>(".writing-group");

  function filterEntries() {
    const words = search.value.toLowerCase().replaceAll("-", " ").trim().split(/\s+/).filter(Boolean);
    let visible = 0;
    entries.forEach(entry => {
      const matches = words.every(word => entry.dataset.search!.includes(word))
        && (!topic.value || entry.dataset.topics!.split(",").includes(topic.value))
        && (!source.value || entry.dataset.source === source.value);
      entry.hidden = !matches;
      if (matches) visible++;
    });
    groups.forEach(group => {
      group.hidden = !group.querySelector(".writing-entry:not([hidden])");
    });
    count.textContent = `${visible} ${visible === 1 ? "article" : "articles"}`;
    empty.hidden = visible > 0;
    clear.hidden = !search.value && !topic.value && !source.value;
  }

  form.hidden = false;
  form.addEventListener("submit", event => event.preventDefault());
  search.addEventListener("input", filterEntries);
  topic.addEventListener("change", filterEntries);
  source.addEventListener("change", filterEntries);
  clear.addEventListener("click", () => {
    form.reset();
    filterEntries();
    search.focus();
  });
  // Reconcile controls restored by the browser when returning to the archive.
  window.addEventListener("pageshow", filterEntries);
  filterEntries();
</script>

<style>
  .page-title {
    font-size: 30px;
    margin-bottom: 1.5rem;
  }

  .archive-filters {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .archive-filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 13px;
    min-width: 0;
  }

  .search-field, .filter-status { grid-column: 1 / -1; }

  input, select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.5rem;
    color: var(--color-text-primary);
    background: var(--color-bg);
    font: inherit;
    font-size: 16px;
  }

  .filter-status {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  #clear-filters {
    color: var(--color-accent);
    cursor: pointer;
    text-decoration: underline;
    padding: 0.25rem 0;
  }

  #no-results { margin-bottom: 2rem; }

  .writing-group {
    margin-bottom: 1.25rem;
  }

  .writing-group:last-of-type {
    margin-bottom: 0;
  }

  .year-heading {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 0.375rem;
  }

  .writing-entries {
    display: flex;
    flex-direction: column;
  }

  .writing-entry {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    padding: 3px 0;
  }

  .entry-title {
    flex: 1;
    font-weight: 450;
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }

  .writing-entry:hover .entry-title {
    color: var(--color-accent);
  }

  .external-indicator {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-left: 0.25rem;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
    margin-left: 1.5rem;
    flex-shrink: 0;
    min-width: 3rem;
    text-align: right;
  }

  @media (max-width: 767px) {
    .entry-date {
      margin-left: 1rem;
    }
  }
</style>
