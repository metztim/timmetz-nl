---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const allWriting = await getCollection("writing", ({ data }) => !data.draft);

const sorted = allWriting.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Collect all unique tags across entries
const allTags = [...new Set(sorted.flatMap(post => post.data.tags))].sort();

const grouped = sorted.reduce<Map<number, typeof sorted>>((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc.has(year)) acc.set(year, []);
  acc.get(year)!.push(post);
  return acc;
}, new Map());

const years = [...grouped.keys()].sort((a, b) => b - a);

function formatDate(date: Date): string {
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${m}.${d}`;
}
---

<Base title="Writing" description="Articles on productivity, AI, startups, and building software.">
  <h1 class="page-title">Writing</h1>

  {allTags.length > 0 && (
    <div class="filter-chips" id="filter-chips">
      {allTags.map(tag => (
        <button class="filter-chip" data-tag={tag} type="button">
          {tag}
        </button>
      ))}
    </div>
  )}

  {years.map(year => (
    <div class="writing-group" data-year={year}>
      <h2 class="year-heading">{year}</h2>
      <div class="writing-entries">
        {grouped.get(year)!.map(post => {
          const isExternal = !!post.data.originalUrl;
          const href = isExternal ? post.data.originalUrl! : `/writing/${post.id}`;
          return (
            <a
              href={href}
              class="writing-entry"
              data-tags={post.data.tags.join(",")}
              {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="entry-title">
                {post.data.title}
                {isExternal && <span class="external-indicator" aria-label="External link">&#8599;</span>}
              </span>
              <span class="entry-date">{formatDate(post.data.pubDate)}</span>
            </a>
          );
        })}
      </div>
    </div>
  ))}
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const entries = document.querySelectorAll<HTMLAnchorElement>(".writing-entry");
  const groups = document.querySelectorAll<HTMLDivElement>(".writing-group");
  const activeTags = new Set<string>();

  chips.forEach(chip => {
    chip.addEventListener("click", () => {
      const tag = chip.dataset.tag!;

      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        chip.classList.remove("active");
      } else {
        activeTags.add(tag);
        chip.classList.add("active");
      }

      filterEntries();
    });
  });

  function filterEntries() {
    const noFilter = activeTags.size === 0;

    entries.forEach(entry => {
      const entryTags = (entry.dataset.tags || "").split(",").filter(Boolean);
      const match = noFilter || entryTags.some(t => activeTags.has(t));
      entry.style.display = match ? "" : "none";
    });

    // Hide year groups that have no visible entries
    groups.forEach(group => {
      const visibleEntries = group.querySelectorAll<HTMLAnchorElement>(
        '.writing-entry:not([style*="display: none"])'
      );
      group.style.display = visibleEntries.length > 0 ? "" : "none";
    });
  }
</script>

<style>
  .page-title {
    font-size: 30px;
    margin-bottom: 2rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 150ms ease;
  }

  .filter-chip:hover {
    color: var(--color-text-secondary);
    border-color: var(--color-text-muted);
  }

  .filter-chip.active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .writing-group {
    margin-bottom: 1.25rem;
  }

  .writing-group:last-of-type {
    margin-bottom: 0;
  }

  .year-heading {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 0.375rem;
  }

  .writing-entries {
    display: flex;
    flex-direction: column;
  }

  .writing-entry {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    padding: 3px 0;
  }

  .entry-title {
    flex: 1;
    font-weight: 450;
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }

  .writing-entry:hover .entry-title {
    color: var(--color-accent);
  }

  .external-indicator {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-left: 0.25rem;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
    margin-left: 1.5rem;
    flex-shrink: 0;
    min-width: 3rem;
    text-align: right;
  }

  @media (max-width: 767px) {
    .entry-date {
      margin-left: 1rem;
    }
  }
</style>
