---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const allWork = await getCollection("work");
const sortedWork = allWork.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

function formatYear(date: Date): string {
  return date.getFullYear().toString();
}
---

<Base title="About" description="Bio, work history, and background of Tim Metz.">
  <h1 class="page-title">About</h1>

  <div class="prose bio">
    <p>
      I build things at the intersection of productivity, AI, and content. I lead marketing
      and AI innovation at <a href="https://www.animalz.co" target="_blank" rel="noopener noreferrer">Animalz</a>,
      a B2B content marketing agency, where I build the AI systems behind the agency's
      editorial work. On the side I make <a href="/projects/lifeline">Lifeline</a>, a macOS
      focus timer, and write <a href="/projects/we-eat-robots">We Eat Robots</a>, a newsletter
      about staying productive and human in the AI era.
    </p>
    <p>
      My path here was anything but linear. I started building websites in 1998, during the
      first dot-com wave, then spent years in video and television: producing electronic
      music TV for DanceTrippin between Amsterdam and Ibiza, making an award-winning daily
      video blog, and traveling the continent for Inside Africa, an internet documentary
      project.
    </p>
    <p>
      In 2008 I moved to Beijing to build the China office of a Dutch digital agency, and
      Asia has been home base for most of the years since: running DanceTrippin, publishing
      mobile games at Happylatte, co-founding <a href="/projects/saent">Saent</a> (a physical
      button plus software for focused work), and leading global marketing at KaiOS, the
      mobile OS named one of TIME's 100 Best Inventions of 2019.
    </p>
    <p>
      Along the way I've lived in the Netherlands, Barcelona, Ibiza, Nairobi, Beijing, Sofia,
      and Hong Kong. These days I'm on Koh Samui, Thailand, with my wife and two kids.
    </p>
    <p>
      This site is the home for everything I make: projects, writing, videos, and experiments,
      collected in one place. It's built and maintained entirely with Claude Code.
    </p>
  </div>

  <section class="section">
    <h2>Work</h2>
    <ul class="work-list">
      {sortedWork.map(entry => (
        <li>
          <span class="work-company">{entry.data.company}</span>
          <span> &mdash; {entry.data.title} </span>
          <span class="work-dates">
            ({formatYear(entry.data.startDate)}&ndash;{entry.data.endDate ? formatYear(entry.data.endDate) : "present"})
          </span>
          {entry.data.location && (
            <span class="work-location"> &middot; {entry.data.location}</span>
          )}
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-title {
    font-size: 30px;
    margin-bottom: 2rem;
  }

  .bio {
    margin-bottom: 3rem;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section h2 {
    font-size: 20px;
    margin-bottom: 1rem;
  }

  .work-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
  }

  .work-list li {
    line-height: 1.5;
  }

  .work-company {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .work-dates {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .work-location {
    font-size: 14px;
    color: var(--color-text-muted);
  }
</style>
