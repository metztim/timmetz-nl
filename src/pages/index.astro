---
import Base from "../layouts/Base.astro";
---

<Base>
  <p class="intro">
    I build things at the intersection of productivity, AI, and software.
    Currently leading AI infrastructure at <a href="/about">Animalz</a> and
    building <a href="/projects/lifeline">Lifeline</a>, a macOS focus timer.
  </p>

  <section class="section">
    <h2>Projects</h2>
    <ul class="project-list">
      <li>
        <a href="/projects/lifeline" class="project-name">Lifeline</a>
        <span class="project-desc"> &mdash; macOS focus timer (4.8&#9733; on App Store)</span>
      </li>
      <li>
        <a href="/projects/we-eat-robots" class="project-name">We Eat Robots</a>
        <span class="project-desc"> &mdash; AI newsletter on Substack</span>
      </li>
      <li>
        <a href="/projects/claude-carbon" class="project-name">Claude Carbon</a>
        <span class="project-desc"> &mdash; VS Code theme</span>
      </li>
      <li>
        <a href="/projects/claudequote" class="project-name">ClaudeQuote</a>
        <span class="project-desc"> &mdash; Quote collection app</span>
      </li>
      <li>
        <a href="/projects/my-os" class="project-name">My-OS</a>
        <span class="project-desc"> &mdash; Personal automation system</span>
      </li>
    </ul>
    <a href="/projects" class="more-link">&rarr; all projects</a>
  </section>

  <section class="section">
    <h2>Writing</h2>
    <div class="writing-group">
      <h3 class="year-heading">2026</h3>
      <div class="writing-entries">
        <a href="#" class="writing-entry">
          <span class="entry-title">Building in Public with AI</span>
          <span class="entry-date">02.10</span>
        </a>
        <a href="#" class="writing-entry">
          <span class="entry-title">The Case for Focused Work in 2026</span>
          <span class="entry-date">01.15</span>
        </a>
      </div>
    </div>
    <div class="writing-group">
      <h3 class="year-heading">2025</h3>
      <div class="writing-entries">
        <a href="#" class="writing-entry">
          <span class="entry-title">How We Built an AI Content Engine</span>
          <span class="entry-date">11.22</span>
        </a>
        <a href="#" class="writing-entry">
          <span class="entry-title">Why I Switched to Claude for Everything</span>
          <span class="entry-date">09.08</span>
        </a>
        <a href="#" class="writing-entry">
          <span class="entry-title">Lessons from 7 Years of Bootstrapping</span>
          <span class="entry-date">06.14</span>
        </a>
      </div>
    </div>
    <a href="/writing" class="more-link">&rarr; all writing</a>
  </section>

  <section class="section">
    <h2>Work</h2>
    <ul class="work-list">
      <li>
        <span class="work-company">Animalz</span>
        <span> &mdash; AI Infrastructure Lead </span>
        <span class="work-dates">(2023&ndash;present)</span>
      </li>
      <li>
        <span class="work-company">Animalz</span>
        <span> &mdash; Content Marketing </span>
        <span class="work-dates">(2019&ndash;2023)</span>
      </li>
      <li>
        <span class="work-company">SAENT</span>
        <span> &mdash; Founder &amp; CEO </span>
        <span class="work-dates">(2015&ndash;2022)</span>
      </li>
      <li>
        <span class="work-company">KOS</span>
        <span> &mdash; Co-founder </span>
        <span class="work-dates">(2011&ndash;2015)</span>
      </li>
    </ul>
    <a href="/about" class="more-link">&rarr; full history</a>
  </section>
</Base>

<style>
  .intro {
    margin-bottom: 3rem;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section:last-child {
    margin-bottom: 0;
  }

  h2 {
    font-size: 20px;
    margin-bottom: 1rem;
  }

  /* More links */
  .more-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 14px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .more-link:hover {
    color: var(--color-accent);
  }

  /* Project list */
  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0;
  }

  .project-list li {
    line-height: 1.5;
  }

  .project-name {
    font-weight: 500;
    text-decoration: none;
  }

  .project-name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .project-desc {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  /* Writing list */
  .writing-group {
    margin-bottom: 1.25rem;
  }

  .writing-group:last-of-type {
    margin-bottom: 0;
  }

  .year-heading {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 0.375rem;
  }

  .writing-entries {
    display: flex;
    flex-direction: column;
  }

  .writing-entry {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    padding: 3px 0;
  }

  .entry-title {
    flex: 1;
    font-weight: 450;
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }

  .writing-entry:hover .entry-title {
    color: var(--color-accent);
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
    margin-left: 1.5rem;
    flex-shrink: 0;
    min-width: 3rem;
    text-align: right;
  }

  /* Work list */
  .work-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0;
  }

  .work-list li {
    line-height: 1.5;
  }

  .work-company {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .work-dates {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .entry-date {
      margin-left: 1rem;
    }
  }
</style>
