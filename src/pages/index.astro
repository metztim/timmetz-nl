---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

const writingByYear = writing.reduce((groups, entry) => {
  const year = entry.data.pubDate.getFullYear().toString();
  (groups[year] ??= []).push(entry);
  return groups;
}, {} as Record<string, typeof writing>);
const years = Object.keys(writingByYear).sort((a, b) => Number(b) - Number(a));

const work = (await getCollection("work"))
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime())
  .slice(0, 4);

function formatDate(date: Date): string {
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return `${mm}.${dd}`;
}

function formatYear(date: Date): string {
  return date.getFullYear().toString();
}
---

<Base>
  <p class="intro">
    I build things at the intersection of productivity, AI, and content.
    Currently leading marketing and AI innovation at <a href="/about">Animalz</a>,
    building <a href="/projects/lifeline">Lifeline</a>, and writing
    <a href="/projects/we-eat-robots">We Eat Robots</a>.
  </p>

  <section class="section">
    <h2>Projects</h2>
    <ul class="project-list">
      {projects.map(project => (
        <li>
          <a href={`/projects/${project.id}`} class="project-name">{project.data.title}</a>
          <span class="project-desc"> &mdash; {project.data.description}</span>
        </li>
      ))}
    </ul>
    <a href="/projects" class="more-link">&rarr; all projects</a>
  </section>

  {years.length > 0 && (
    <section class="section">
      <h2>Writing</h2>
      {years.map(year => (
        <div class="writing-group">
          <h3 class="year-heading">{year}</h3>
          <div class="writing-entries">
            {writingByYear[year].map(entry =>
              entry.data.originalUrl ? (
                <a href={entry.data.originalUrl} class="writing-entry" target="_blank" rel="noopener noreferrer">
                  <span class="entry-title">{entry.data.title} &nearr;</span>
                  <span class="entry-date">{formatDate(entry.data.pubDate)}</span>
                </a>
              ) : (
                <a href={`/writing/${entry.id}`} class="writing-entry">
                  <span class="entry-title">{entry.data.title}</span>
                  <span class="entry-date">{formatDate(entry.data.pubDate)}</span>
                </a>
              )
            )}
          </div>
        </div>
      ))}
      <a href="/writing" class="more-link">&rarr; all writing</a>
    </section>
  )}

  <section class="section">
    <h2>Work</h2>
    <ul class="work-list">
      {work.map(entry => (
        <li>
          <span class="work-company">{entry.data.company}</span>
          <span> &mdash; {entry.data.title} </span>
          <span class="work-dates">
            ({formatYear(entry.data.startDate)}&ndash;{entry.data.endDate ? formatYear(entry.data.endDate) : "present"})
          </span>
        </li>
      ))}
    </ul>
    <a href="/about" class="more-link">&rarr; full history</a>
  </section>
</Base>

<style>
  .intro {
    margin-bottom: 3rem;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section:last-child {
    margin-bottom: 0;
  }

  h2 {
    font-size: 20px;
    margin-bottom: 1rem;
  }

  /* More links */
  .more-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 14px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .more-link:hover {
    color: var(--color-accent);
  }

  /* Project list */
  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0;
  }

  .project-list li {
    line-height: 1.5;
  }

  .project-name {
    font-weight: 500;
    text-decoration: none;
  }

  .project-name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .project-desc {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  /* Writing list */
  .writing-group {
    margin-bottom: 1.25rem;
  }

  .writing-group:last-of-type {
    margin-bottom: 0;
  }

  .year-heading {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 0.375rem;
  }

  .writing-entries {
    display: flex;
    flex-direction: column;
  }

  .writing-entry {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    padding: 3px 0;
  }

  .entry-title {
    flex: 1;
    font-weight: 450;
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }

  .writing-entry:hover .entry-title {
    color: var(--color-accent);
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
    margin-left: 1.5rem;
    flex-shrink: 0;
    min-width: 3rem;
    text-align: right;
  }

  /* Work list */
  .work-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0;
  }

  .work-list li {
    line-height: 1.5;
  }

  .work-company {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .work-dates {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .entry-date {
      margin-left: 1rem;
    }
  }
</style>
