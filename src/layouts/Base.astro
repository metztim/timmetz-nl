---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";
import Sidebar from "../components/Sidebar.astro";
import MobileNav from "../components/MobileNav.astro";
import MobileFooter from "../components/MobileFooter.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object;
}

const { title, description, ogImage, ogType, jsonLd } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Tim Metz — Writing" href="/rss.xml" />
  <SEOHead title={title} description={description} ogImage={ogImage} ogType={ogType} jsonLd={jsonLd} />
  <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body>
  <MobileNav currentPath={currentPath} />
  <div class="layout">
    <Sidebar currentPath={currentPath} />
    <main class="main">
      <slot />
    </main>
  </div>
  <MobileFooter />
</body>
</html>

<style>
  .layout {
    display: flex;
    min-height: 100vh;
  }

  .main {
    flex: 1;
    max-width: 640px;
    padding: 2.5rem 2rem 4rem;
  }

  @media (max-width: 767px) {
    .layout {
      flex-direction: column;
      min-height: auto;
    }

    .main {
      max-width: 100%;
      padding: 1.5rem 1.25rem 2rem;
    }
  }
</style>
