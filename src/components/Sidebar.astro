---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navItems = [
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/workflows", label: "Workflows" },
  { href: "/about", label: "About" },
];

const socialLinks = [
  { href: "https://github.com/timmetz", label: "GitHub" },
  { href: "https://linkedin.com/in/timmetz", label: "LinkedIn" },
  { href: "/rss.xml", label: "RSS" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <div class="sidebar-top">
      <a href="/" class="site-name">Tim Metz</a>
      <nav class="sidebar-nav">
        {navItems.map(item => (
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="sidebar-bottom">
      <div class="sidebar-separator"></div>
      <div class="sidebar-social">
        {socialLinks.map(link => (
          <a href={link.href} {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
            {link.label}
          </a>
        ))}
      </div>
      <ThemeToggle />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 2.5rem 1.5rem 2rem;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .sidebar-top {
    flex: 1;
  }

  .site-name {
    display: block;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    margin-bottom: 2rem;
    letter-spacing: -0.01em;
  }

  .site-name:hover {
    color: var(--color-accent);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-nav a {
    font-size: 15px;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .sidebar-nav a:hover,
  .sidebar-nav a.active {
    color: var(--color-text-primary);
  }

  .sidebar-bottom {
    padding-top: 1rem;
  }

  .sidebar-separator {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 1rem;
    transition: background-color 200ms ease;
  }

  .sidebar-social {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
  }

  .sidebar-social a {
    font-size: 13px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .sidebar-social a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .sidebar {
      display: none;
    }
  }
</style>

