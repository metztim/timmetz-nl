---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navItems = [
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/about", label: "About" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="mobile-header">
  <a href="/" class="site-name">Tim Metz</a>
  <nav aria-label="Main navigation" class="mobile-nav-links">
    {navItems.map(item => (
      <a href={item.href} class:list={[{ active: isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <ThemeToggle />
</header>

<style>
  .mobile-header {
    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    transition: border-color 200ms ease;
  }

  .site-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .mobile-nav-links {
    display: flex;
    order: 3;
    width: 100%;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .mobile-nav-links a {
    font-size: 14px;
    padding: 0.5rem 0;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .mobile-nav-links a:hover,
  .mobile-nav-links a.active {
    color: var(--color-text-primary);
  }

  @media (max-width: 767px) {
    .mobile-header {
      display: flex;
    }
  }
</style>
